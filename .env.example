# Server
PORT=3000
SERVICE_NAME=profile_api
NODE_ENV=development
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/profiles?schema=public
DB_POOL_MAX=10
DB_POOL_WARM=4
DB_POOL_IDLE_MS=300000
DB_POOL_CONNECT_TIMEOUT_MS=10000
DB_POOL_KEEPALIVE_DELAY_MS=10000

# Redis (shared with bcn_quiz; key prefix bcn:profiles:)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=bcn:profiles:
# REDIS_PASSWORD=
# REDIS_SENTINELS=127.0.0.1:26379,127.0.0.1:26380,127.0.0.1:26381
# REDIS_SENTINEL_NAME=mymaster
# REDIS_SENTINEL_PASSWORD=

# JWT (access and refresh must use different secrets)
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Optional TOTP encryption (falls back to JWT_SECRET if unset)
TOTP_ENCRYPTION_KEY=

# Email (Gmail App Password recommended)
EMAIL_USER=
EMAIL_PASSWORD=
MAIL_TLS_REJECT_UNAUTHORIZED=true

# Cache warm cron (node-cron / Nest CronExpression name or leave default)
# Default: EVERY_5_MINUTES
CACHE_WARM_CRON=EVERY_5_MINUTES

# Logging
LOG_LEVEL=info
LOG_DIR=logs
LOG_FILE_ENABLED=true
LOKI_ENABLED=false
LOKI_HOST=
