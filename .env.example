# Server
PORT=3000
SERVICE_NAME=profile_api
NODE_ENV=development
APP_URL=http://localhost:3000

# Database — shared Postgres instance, database `profiles`
# (start infra from NestJS/: docker compose up -d)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/profiles?schema=public
DB_POOL_MAX=10
DB_POOL_MIN=1
DB_POOL_IDLE_MS=300000
DB_POOL_CONNECT_TIMEOUT_MS=10000

# Redis — shared with bcn_quiz
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=bcn:profiles:
# REDIS_PASSWORD=
# REDIS_SENTINELS=127.0.0.1:26379,127.0.0.1:26380,127.0.0.1:26381
# REDIS_SENTINEL_NAME=mymaster
# REDIS_SENTINEL_PASSWORD=

# JWT (access and refresh must use different secrets)
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Optional TOTP encryption (falls back to JWT_SECRET if unset)
TOTP_ENCRYPTION_KEY=

# Email via Resend (https://resend.com)
# Dev có thể dùng onboarding@resend.dev; production cần domain đã verify.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM="BCN Support <onboarding@resend.dev>"
MAIL_QUEUE_CONCURRENCY=5

# Logging
LOG_LEVEL=info
LOG_DIR=logs
LOG_FILE_ENABLED=true
LOKI_ENABLED=false
LOKI_HOST=
