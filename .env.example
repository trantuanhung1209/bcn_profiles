# Server
APP_PORT=3000
HOST_PORT=18085
PORT=3000 # optional
SERVICE_NAME=profile_api # optional
NODE_ENV=production # optional
CORS_ORIGINS= # optional
APP_URL=

# Shared production PostgreSQL. DATABASE_URL is generated by CI/CD.
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=profiles
DB_USERNAME=profiles_app
DB_PASSWORD=
DB_SCHEMA=public
# Optional direct URL for host development (use localhost:5433).
DATABASE_URL= # optional
DB_POOL_MAX=10 # optional
DB_POOL_MIN=1 # optional
DB_POOL_IDLE_MS=300000 # optional
DB_POOL_CONNECT_TIMEOUT_MS=10000 # optional

# Shared Redis: database 0, application namespace.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=profiles:
# Optional legacy URL for host development; unset REDIS_HOST to use it.
REDIS_URL= # optional

# JWT (access and refresh must use different secrets)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Optional TOTP encryption (falls back to JWT_SECRET if unset)
TOTP_ENCRYPTION_KEY= # optional

# Email via Resend (https://resend.com)
# Dev có thể dùng onboarding@resend.dev; production cần domain đã verify.
RESEND_API_KEY=
EMAIL_FROM="BCN Support <onboarding@resend.dev>"
MAIL_QUEUE_CONCURRENCY=5 # optional

# MinIO (client converts avatar to WebP before upload)
MINIO_AVATAR_FOLDER=user-avatars # optional
MINIO_IMAGE_MAX_BYTES=2097152 # optional

# Cache
USERS_LIST_CACHE_TTL_MS=60000 # optional
TIMELINE_CACHE_TTL_MS=60000 # optional

# Logging
LOG_LEVEL=info # optional
LOG_DIR=logs # optional
LOG_FILE_ENABLED=false # optional
LOKI_ENABLED=false # optional
LOKI_HOST= # optional
LOKI_BASIC_AUTH= # optional
LOKI_BATCH_INTERVAL_SECONDS=5 # optional
LOKI_TIMEOUT_MS=10000 # optional

# Shared MinIO: sign PUT/GET URLs using this exact HTTPS endpoint.
MINIO_ENDPOINT=https://storage.bcn.id.vn
MINIO_BUCKET=profiles
MINIO_ACCESS_KEY=KwHj4B2O78nyd2wtb4HA
MINIO_SECRET_KEY=SqgEL7GXRaH44lCQ6g1SIaEdKm0GulA9ec4sDUcY
MINIO_REGION=us-east-1 # optional
MINIO_FORCE_PATH_STYLE=true
